+<script>
+/* Navigation : menus au clic (jamais au survol), rubrique et page marquées,
+   fil d'Ariane et onglets des pages sœurs construits depuis les liens du menu.
+   Une seule source : ce qui est dans le menu est ce qui est proposé ailleurs. */
+(function(){
+  var menus = Array.prototype.slice.call(document.querySelectorAll('.rust-nav .rust-menu'));
+  if(!menus.length) return;
+
+  function fermerTout(sauf){
+    menus.forEach(function(menu){
+      if(menu === sauf) return;
+      menu.querySelector('button').setAttribute('aria-expanded','false');
+    });
+  }
+  menus.forEach(function(menu){
+    var bouton = menu.querySelector('button');
+    bouton.addEventListener('click', function(event){
+      event.stopPropagation();
+      var ouvert = bouton.getAttribute('aria-expanded') === 'true';
+      fermerTout(menu);
+      bouton.setAttribute('aria-expanded', String(!ouvert));
+    });
+  });
+  document.addEventListener('click', function(){ fermerTout(null); });
+  document.addEventListener('keydown', function(event){
+    if(event.key === 'Escape'){
+      fermerTout(null);
+      var ouvert = document.querySelector('.rust-nav .rust-menu > button[aria-expanded=true]');
+      if(ouvert) ouvert.focus();
+    }
+  });
+
+  // Une page appartient à la rubrique dont un lien correspond au chemin courant ;
+  // à défaut, au premier lien dont le chemin est un préfixe (ex. /bande/12 → /bandes).
+  function situer(){
+    var chemin = window.location.pathname.replace(/\/+$/,'') || '/';
+    var exact = null, approche = null;
+    menus.forEach(function(menu){
+      menu.querySelectorAll('a[href^="/"]').forEach(function(lien){
+        lien.removeAttribute('aria-current');
+        var cible = lien.getAttribute('href').replace(/\/+$/,'') || '/';
+        if(cible === chemin){ exact = exact || {menu:menu, lien:lien}; }
+        else if(cible !== '/' && chemin.indexOf(cible) === 0){ approche = approche || {menu:menu, lien:lien}; }
+      });
+      menu.classList.remove('rubrique-active');
+    });
+    // Racine des pages de détail : /bande/12 relève de /bandes, /truie/8 de /truies.
+    if(!exact && !approche){
+      var racine = '/' + chemin.split('/')[1];
+      var equivalents = {'/bande':'/bandes','/truie':'/truies','/salle':'/structure',
+        '/soin-portee':'/maternite','/charcutier':'/charcutiers','/transfert':'/transferts',
+        '/entretien':'/taches','/recherche':'/truies','/import':'/imports','/gte':'/gte'};
+      var vise = equivalents[racine];
+      if(vise){
+        menus.forEach(function(menu){
+          var lien = menu.querySelector('a[href="' + vise + '"]');
+          if(lien && !approche){ approche = {menu:menu, lien:lien}; }
+        });
+      }
+    }
+    return exact || approche;
+  }
+
+  function construire(){
+    var place = situer();
+    var fil = document.getElementById('fil-ariane');
+    var onglets = document.getElementById('onglets-section');
+    if(!fil || !onglets) return;
+    fil.textContent = '';
+    onglets.textContent = '';
+    if(!place){ onglets.hidden = true; return; }
+
+    place.menu.classList.add('rubrique-active');
+    place.lien.setAttribute('aria-current','page');
+    var rubrique = place.menu.dataset.rubrique || '';
+    var titre = (place.lien.querySelector('b') || place.lien).textContent.trim();
+    var exacte = place.lien.getAttribute('href').replace(/\/+$/,'') ===
+      (window.location.pathname.replace(/\/+$/,'') || '/');
+
+    var dedans = document.createElement('div');
+    dedans.className = 'dedans';
+    var accueil = document.createElement('a');
+    accueil.href = '/'; accueil.textContent = 'Accueil';
+    dedans.appendChild(accueil);
+    [rubrique, titre].forEach(function(texte, index){
+      if(!texte) return;
+      var sep = document.createElement('span'); sep.textContent = '›'; dedans.appendChild(sep);
+      var element;
+      if(index === 1 && exacte){ element = document.createElement('span'); element.className = 'ici'; }
+      else if(index === 1){ element = document.createElement('a'); element.href = place.lien.getAttribute('href'); }
+      else { element = document.createElement('span'); }
+      element.textContent = texte;
+      dedans.appendChild(element);
+    });
+    if(!exacte){
+      var sep = document.createElement('span'); sep.textContent = '›'; dedans.appendChild(sep);
+      var ici = document.createElement('span'); ici.className = 'ici';
+      ici.textContent = (document.title || '').split('·')[0].trim() || 'Détail';
+      dedans.appendChild(ici);
+    }
+    fil.appendChild(dedans);
+
+    // Onglets : les pages sœurs de la rubrique, dans l'ordre du menu.
+    var soeurs = place.menu.querySelectorAll('a[href^="/"]');
+    if(soeurs.length > 1){
+      soeurs.forEach(function(lien){
+        var onglet = document.createElement('a');
+        onglet.href = lien.getAttribute('href');
+        onglet.textContent = (lien.querySelector('b') || lien).textContent.trim();
+        if(lien === place.lien) onglet.className = 'actif';
+        onglets.appendChild(onglet);
+      });
+      onglets.hidden = false;
+    } else {
+      onglets.hidden = true;
+    }
+
+    // Barre du bas : marquer l'entrée correspondant à la rubrique courante.
+    var correspondances = {'Aujourd’hui':'/quotidien','Mes animaux':'/bandes',
+      'Mes résultats':'/gte','Ma gestion':'/economique'};
+    var vise = correspondances[rubrique];
+    document.querySelectorAll('.nav-pouce a[data-pouce]').forEach(function(lien){
+      if(lien.dataset.pouce === vise){ lien.setAttribute('aria-current','page'); }
+      else { lien.removeAttribute('aria-current'); }
+    });
+  }
+  construire();
+  document.addEventListener('eo:contenu-actualise', construire);
+
+  // Le bouton « Saisir » de la barre du bas ouvre la saisie rapide déjà en place.
+  var saisir = document.getElementById('pouce-saisir');
+  var fab = document.getElementById('fab');
+  if(saisir && fab){ saisir.addEventListener('click', function(){ fab.click(); }); }
+})();
+</script>
