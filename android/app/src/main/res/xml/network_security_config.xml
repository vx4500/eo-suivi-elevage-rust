<?xml version="1.0" encoding="utf-8"?>
<!--
  Le HTTP en clair est autorisé : un élevage sans accès internet ne peut pas
  obtenir de certificat Let's Encrypt, et son serveur n'est joignable que par
  son IP privée. Android ne permet pas de restreindre l'autorisation à une
  plage d'adresses (les règles portent sur des noms de domaine, et l'IP du
  serveur change d'un élevage à l'autre), d'où une autorisation générale.

  Conséquence assumée et à documenter à l'installation : sur ces réseaux, le
  cookie de session circule en clair sur le réseau local de l'élevage. Un
  élevage qui dispose d'un domaine et d'un certificat utilise l'adresse
  externe en HTTPS et n'est pas concerné.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Un certificat installé par l'éleveur (autorité interne) est
                 accepté : sinon un élevage qui gère son propre HTTPS local
                 verrait l'application refuser sa page. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
